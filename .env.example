# Copy to .env.local for local development. Values are set by Karim (never committed).
# Hosted Supabase project "Ekonomi mbimpact.se" (ref mmiuuwrfcumcpgyleufu, eu-north-1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: used only by the login throttle RPCs public.login_gate/login_record (granted
# to service_role alone). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server-only: the e-mail of the single Supabase Auth user. Random, non-public address.
STATS_LOGIN_EMAIL=
