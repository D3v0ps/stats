# Copy to .env.local for local development. Values are set by Karim (never committed).
# Supabase project "mb-stats" (eu-north-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: used by the login throttle (private.login_gate/login_record). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server-only: the e-mail of the single Supabase Auth user. Random, non-public address.
STATS_LOGIN_EMAIL=
